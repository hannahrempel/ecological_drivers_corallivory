if (!require(devtools)) install.packages("devtools")  #for installing from a few of the following packages from github
library(devtools)
#installs packages if not on the users computer
if (!require(leaflet)) install.packages("leaflet") # for interactive maps
if (!require(ggmap)) devtools::install_github("dkahle/ggmap") #for happy coding with ggmaps
if (!require(ggspatial)) install.packages("ggspatial") #for mapping in ggplot
if (!require(sf)) install.packages("sf") #for creating maps
if (!require(ggrepel)) install.packages("ggrepel") #for text repel/jitter on map
if (!require(here)) install.packages("here") #for text repel/jitter on map
#create a list of packages to load at once
packages <- c("leaflet", "ggmap", "tidyverse","ggspatial", "sf",  "ggrepel", "here")
sapply(packages, require, character.only = T)
#static caribbean basemap in high resolution
carib_basemap <- st_read(paste0(here(), "/site_maps/Caribbean_shapefiles_mapping/Carib5.shp"))
class(carib_basemap) #confimring it's an sf class
#data on locations of individual study sites in each region
site_map_data <- read_csv(paste0(here(), "/site_maps/ecological_drivers_corallivory_site_coordinates.csv"))
#regional data for map of Caribbean zoomed-out
region <- c("Florida (n=4)", "St. Croix (n=8)", "Bonaire (n=4)", "Panamá (n=10)")
numeric_label <- c("1", "2", "3", "4")
latitude <- c(24.9822685, 17.7362838, 12.1841076, 9.351736)
longitude <- c(-80.3889687, -64.7626946, -68.2668218, -82.257520)
region_data <- data.frame(region, numeric_label, latitude, longitude)
#icons for each region
icons <- awesomeIcons(icon = "glyphicon-map-marker", library = "glyphicon", markerColor = c("orange", "blue", "purple", "green"), iconColor = "white")
#pallette for the dots at each site
pal <- colorFactor( palette = c("#00B1EA", "#FE4248", "#8266FF", "#520E44"), domain = site_map_data$region)
leaflet(data=site_map_data) %>%
setView(lng = -73, lat = 17.8, zoom = 4.4) %>% #sets the view when the map loads
addTiles()  %>% #necessary to have map
#different background options
addProviderTiles(providers$Stadia.StamenWatercolor, group="Watercolor") %>% #for funsies
addProviderTiles(providers$CartoDB.Positron, group="Grayscale") %>% #gray publication style
addAwesomeMarkers(region_data, lng = longitude, lat = latitude, icon = icons, group = region, popup=region) %>% #region color makers
addCircles(lng= ~longitude, lat= ~latitude, weight = 10, radius = 10, popup=~site, color = ~pal(region)) %>%
addMiniMap()%>% #mini map in lower right
addLayersControl(overlayGroups = c("Grayscale","Watercolor"), options = layersControlOptions(collapsed = FALSE)) %>%
addScaleBar(position = "topleft") #scale bar
#regional map
region_map <- ggplot(data = carib_basemap) +
geom_sf() + #adding basemap
coord_sf(xlim = c(-99, -58), ylim = c(8, 32), expand = FALSE) + #setting basemap dimensions
labs(x="", y="")+
theme_linedraw()+
theme(
panel.border = element_rect(colour = "black",  size = 1, linetype = "solid"),
panel.background = element_rect(fill = "#83D2EB", #background fill
colour = "black",  size = 0.5, linetype = "solid"), #outline
panel.grid.major = element_blank() # no gridlines
#panel.grid.major = element_line(size = 0.5, linetype = 'solid',  colour = "lightsteelblue2")) #, # adds faint gridlines to map
)+
annotate(geom = "text", x = -90, y = 25, label = "Gulf of Mexico", fontface = "italic", color = "black", size = 5) +
annotate(geom = "text", x = -77, y = 15, label = "Caribbean Sea", fontface = "italic", color = "black", size = 5) +
geom_point(data = region_data, aes(x = longitude, y = latitude), size = 2,  shape = 16, color = "black") +#adding regional data points
ggrepel::geom_label_repel(data = region_data, aes(x = longitude, y = latitude, label = region),
fontface = "bold", nudge_x = c(1, 1, 1), nudge_y = c(2,2,2), size = 5) +
ggspatial::annotation_scale(line_width = 0.5, width_hint=0.2, pad_x = unit(0.3, "cm"))
region_map
